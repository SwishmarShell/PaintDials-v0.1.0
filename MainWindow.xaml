<Window x:Class="PaintDials.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="PaintDials v0.1.0"
Width="477"
Height="274"
ResizeMode="NoResize">
    <Grid Margin="10,10,255,16" RenderTransformOrigin="0.591,0.508">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- ============================================ -->
        <!-- Opacity Dial -->
        <!-- ============================================ -->
        <Canvas x:Name="OpacityDial"
                Grid.Column="0"
                Width="220"
                Height="220"
                MouseEnter="DialPoint_MouseEnter_Cercle"
                MouseLeave="DialPoint_MouseLeave_Cercle"
                PreviewMouseWheel="Opacity_MouseWheel">
                    <TextBlock Text="不透明度"
                        FontWeight="Bold"
                        FontSize="17"
                        Canvas.Left="83"
                        Canvas.Top="64"/>
            <!-- Dial Circle -->
            <Ellipse x:Name="OpacityDialCircle"
                    Width="140"
                    Height="140"
                    Stroke="#E0E0E0"
                    StrokeThickness="15"
                    Canvas.Left="48"
                    Canvas.Top="35"/>
            <!-- Median -->
            <TextBlock x:Name="OpacityText"
                    Text="100%"
                    FontSize="28"
                    FontWeight="Bold"
                    Width="100"
                    TextAlignment="Center"
                    Canvas.Left="72"
                    Canvas.Top="95"/>
            <!-- 左側 1% -->
            <Ellipse x:Name="OpacityStep1"
                    Width="18"
                    Height="18"
                    Fill="Orange"
                    Canvas.Left="33"
                    Canvas.Top="66"
                    MouseLeftButtonDown="OpacityStep1_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="1%"
                    FontSize="14"
                    Canvas.Left="25"
                    Canvas.Top="45"/>
            <!-- 右側 10% -->
            <Ellipse x:Name="OpacityStep10"
                    Width="18"
                    Height="18"
                    Fill="Gray"
                    Canvas.Left="185"
                    Canvas.Top="66"
                    MouseLeftButtonDown="OpacityStep10_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="10%"
                    FontSize="14"
                    Canvas.Left="170"
                    Canvas.Top="45"/>
            </Canvas>
        <!-- ============================================ -->
        <!-- Brush Size Dial -->
        <!-- ============================================ -->
        <Canvas x:Name="SizeDial"
            Grid.Column="1"
            MouseEnter="DialPoint_MouseEnter_Cercle2"
            MouseLeave="DialPoint_MouseLeave_Cercle2"
            PreviewMouseWheel="Size_MouseWheel" Margin="254,48,-190,28">
                <TextBlock Text="ブラシサイズ"
                        FontWeight="Bold"
                        FontSize="17"
                        Canvas.Left="30"
                        Canvas.Top="23"/>
            <!-- ダイヤル円（中を塗る+Circle -->
            <Ellipse x:Name="SizeDialCircle"
                Width="138"
                Height="138"
                Stroke="#B0B0B0"
                StrokeThickness="8"/>
            <!-- 中央値 -->
            <TextBlock x:Name="SizeText"
                Text="25.00px"
                FontSize="25"
                FontWeight="Bold"
                Width="130"
                Canvas.Left="24"
                Canvas.Top="52"/>
            <!-- 0.01px -->
            <Ellipse x:Name="SizeStep001"
                Tag="0.01"
                Width="24"
                Height="24"
                Fill="Gray"
                Canvas.Left="-13"
                Canvas.Top="105"
                MouseLeftButtonDown="SizeStep_Click"
                MouseEnter="DialPoint_MouseEnter"
                MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="0.01px"
                    FontSize="12"
                    Canvas.Left="-41"
                    Canvas.Top="89" HorizontalAlignment="Left" Height="55" VerticalAlignment="Top" Width="44"
                    IsHitTestVisible="False"/>
            <!-- 0.1px -->
            <Ellipse x:Name="SizeStep01"
                    Tag="0.1"
                    Width="24"
                    Height="24"
                    Fill="Gray"
                    Canvas.Left="-17"
                    Canvas.Top="31"
                    MouseLeftButtonDown="SizeStep_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="0.1px"
                    FontSize="12"
                    Canvas.Left="-30"
                    Canvas.Top="12" Height="33" Width="27" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False"/>
            <!-- 1px -->
            <Ellipse x:Name="SizeStep1"
                    Tag="1"
                    Width="24"
                    Height="24"
                    Fill="Orange"
                    Canvas.Left="55"
                    Canvas.Top="-13"
                    MouseLeftButtonDown="SizeStep_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="1px"
                    FontSize="12"
                    Canvas.Left="56"
                    Canvas.Top="-30" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="21"
                    IsHitTestVisible="False"/>
            <!-- 10px -->
            <Ellipse x:Name="SizeStep10"
                    Tag="10"
                    Width="24"
                    Height="24"
                    Fill="Gray"
                    Canvas.Left="132"
                    Canvas.Top="30"
                    MouseLeftButtonDown="SizeStep_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="10px"
                    FontSize="12"
                    Canvas.Left="127"
                    Canvas.Top="12" HorizontalAlignment="Left" Height="33" VerticalAlignment="Top"
                    IsHitTestVisible="False"/>
            <!-- 100px -->
            <Ellipse x:Name="SizeStep100"
                    Tag="100"
                    Width="24"
                    Height="24"
                    Fill="Gray"
                    Canvas.Left="128"
                    Canvas.Top="105"
                    MouseLeftButtonDown="SizeStep_Click"
                    MouseEnter="DialPoint_MouseEnter"
                    MouseLeave="DialPoint_MouseLeave"/>
                <TextBlock Text="100px"
                    FontSize="12"
                    Canvas.Left="132"
                    Canvas.Top="89" HorizontalAlignment="Left" Height="55" VerticalAlignment="Top"
                    IsHitTestVisible="False"/>
        </Canvas>
    </Grid>
</Window>